{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=Interact_Hub;TrustServerCertificate=True",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Issuer": "InteractHub",
    "Audience": "InteractHub",
    "ExpireHours": "24"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "MaxUploadBytes": 10485760
  },
  "StoryCleanup": {
    "IntervalHours": 1.0
  },
  "Neo4j": {
    "Uri": "bolt://localhost:7687",
    "User": "neo4j"
  },
  "LLM": {
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-4o-mini",
      "BaseUrl": "https://api.openai.com/v1"
    }
  },
  "ChatBot": {
    "SessionHistoryWindow": 10,
    "SessionTtlHours": 24,
    "CacheSimilarityThreshold": 0.92,
    "CacheTtlHours": 24,
    "VectorIndex": {
      "IndexName": "chatbot-docs",
      "EmbeddingDimensions": 1536,
      "TopK": 5
    },
    "Embedding": {
      "Model": "text-embedding-3-small"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}